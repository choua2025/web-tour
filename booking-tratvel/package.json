{
  "name": "booking-travel",
  "version": "1.0.0",
  "description": "Travel Booking System API - Node.js + Sequelize + PostgreSQL",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "migrate": "node src/scripts/migrate.js status",
    "migrate:up": "node src/scripts/migrate.js up",
    "migrate:down": "node src/scripts/migrate.js down",
    "migrate:baseline": "node src/scripts/migrate.js baseline",
    "check:mail": "node src/scripts/check-mail.js",
    "check:schema": "node src/scripts/check-schema.js"
  },
  "keywords": [
    "travel",
    "booking",
    "api",
    "sequelize",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.1",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
