# Copy to `.env` next to this project's docker-compose.yml.
#   cp .env.docker.example .env

# Where the browser reaches the API. It runs on the admin's own machine, so
# it must be an address they can resolve — not http://api:9001.
PUBLIC_API_URL=http://localhost:9001/api

# Port on the host.
ADMIN_PORT=3000

# Image tag.
TAG=latest
