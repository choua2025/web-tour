# Everything here would otherwise be shipped into the build context, which
# slows every build. node_modules alone is hundreds of megabytes.

# Reinstalled inside the image from the lockfile
node_modules

# Build artefacts — regenerated by `nuxt build` in the build stage
.nuxt
.output
.nitro
.data
.cache
dist

# Secrets — the container gets these as environment variables instead
.env
.env.*
!.env.example

# Local noise
.git
.gitignore
*.log
logs
.DS_Store
.idea
.vscode

*.md

# Never copy a Dockerfile into its own image
Dockerfile
.dockerignore
