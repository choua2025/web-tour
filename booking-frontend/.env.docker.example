# Copy to `.env` next to this project's docker-compose.yml.
#   cp .env.docker.example .env

# Where the visitor's BROWSER reaches the API. Behind a domain this becomes
# e.g. https://api.example.com/api
PUBLIC_API_URL=http://localhost:9001/api

# Where THIS container reaches the API during server-side rendering. The
# default works when the API publishes 9001 on the Docker host. Put this
# container on the API's own compose network instead and use
# http://api:9001/api.
SERVER_API_URL=http://host.docker.internal:9001/api

# Port on the host.
STOREFRONT_PORT=3001

# Image tag.
TAG=latest
