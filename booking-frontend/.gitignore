# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
.fleet
.idea
.vscode/*
!.vscode/extensions.json

# Local env files
# The API base URL lives in nuxt.config.ts; anything overridden per machine
# (NUXT_PUBLIC_API_BASE) belongs in .env and must not be committed.
.env
.env.*
!.env.example
# The Docker template carries no values, only variable names — it is meant
# to be committed so a fresh clone knows what to fill in.
!.env.docker.example
