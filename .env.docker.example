# Copy to `.env` next to docker-compose.yml and fill in.
#   cp .env.docker.example .env
#
# docker-compose.yml reads this file. Nothing here is baked into an image.

# ── database ────────────────────────────────────────────────────────
DB_NAME=booking_system
DB_USER=postgres
DB_PASSWORD=change-me

# ── auth ────────────────────────────────────────────────────────────
# The API refuses to start on a missing or placeholder secret. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── where the browser reaches the API ───────────────────────────────
# Used by BOTH front ends. It runs in the visitor's browser, so it must be an
# address they can resolve — `http://api:9001` only works inside the network.
# Behind a domain this becomes e.g. https://api.example.com/api
PUBLIC_API_URL=http://localhost:9001/api

# Where Stripe sends the customer back after checkout — the STOREFRONT,
# not the admin console.
FRONTEND_URL=http://localhost:3001

# ── ports on the host ───────────────────────────────────────────────
API_PORT=9001
ADMIN_PORT=3000
STOREFRONT_PORT=3001
DB_PUBLISH_PORT=5432

# ── email (password reset + booking confirmations) ──────────────────
# Gmail needs an App Password, not the account password. Check it with:
#   docker compose run --rm api npm run check:mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ── uploads ─────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── payments ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Leave blank for local runs. Without it the webhook trusts the request body
# unverified, which is fine behind `stripe listen` and unsafe in production.
STRIPE_WEBHOOK_SECRET=

# ── misc ────────────────────────────────────────────────────────────
# One line per API request in the container logs. Set false to quieten.
LOG_REQUESTS=true

# Image tag used by `docker compose build` / CI.
TAG=latest
